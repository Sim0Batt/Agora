# Fase 1: Compilazione con Gradle
FROM gradle:8-jdk17 AS build

# Koyeb sta copiando l'intera repository (sia frontend che backend)
COPY --chown=gradle:gradle . /home/gradle/src

# Entriamo ESPLICITAMENTE nella cartella del backend
WORKDIR /home/gradle/src/AgoraServer

# Ora siamo nella cartella giusta, lanciamo la compilazione!
RUN gradle shadowJar --no-daemon

# Fase 2: Creazione dell'immagine di Esecuzione (ultra-leggera)
FROM eclipse-temurin:24-jre-alpine

EXPOSE 8000
RUN mkdir /app

# Andiamo a pescare il JAR compilato (nota che il percorso ora include /AgoraServer/)
COPY --from=build /home/gradle/src/AgoraServer/build/libs/AgoraServer.jar /app/ktor-app.jar

# Lancia il server
ENTRYPOINT ["java", "-jar", "/app/ktor-app.jar"]